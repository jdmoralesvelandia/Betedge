# Copy to .env and fill in real values. Never commit .env.
# Loaded automatically by springboot4-dotenv when running ./mvnw spring-boot:run - no need to
# export these by hand. Real OS/system environment variables always take precedence over this
# file, so production deployments (which set real env vars) are unaffected.

# Active Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8080

# Database (used by docker-compose and by the app's datasource)
DB_HOST=localhost
# 5433 here (not Postgres's default 5432) because of a machine-specific conflict on the original
# dev machine (a native Windows PostgreSQL install for another course) - see docker-compose.yml.
# If 5432 is free on your machine, plain 5432 works fine too.
DB_PORT=5433
DB_NAME=betedge
DB_USERNAME=betedge
DB_PASSWORD=betedge

# JWT (secret must be at least 32 bytes for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
# Secure flag on the refreshToken cookie. Defaults to false in the dev profile (plain http)
# and true in the prod profile (https required) - only set this to override that default.
# JWT_REFRESH_COOKIE_SECURE=false

# Shared secret required by POST /auth/bootstrap-admin (X-Bootstrap-Secret header)
ADMIN_BOOTSTRAP_SECRET=change-me-to-a-long-random-secret

# Frontend origin allowed to call the API with credentials (cookies) - must be an exact
# origin, never "*", since CORS forbids wildcard origins when allowCredentials is true.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# OddsPapi (https://api.oddspapi.io)
ODDSPAPI_API_KEY=your-oddspapi-key-here
# ODDSPAPI_BASE_URL=https://api.oddspapi.io/v4

# The Odds API (https://the-odds-api.com) - complementary source (see README-notas.md). Budget is
# 500 calls/month, confirmed at 1 credit/call via the x-requests-last header.
THEODDSAPI_API_KEY=your-theoddsapi-key-here
# THEODDSAPI_BASE_URL=https://api.the-odds-api.com/v4

# Paso C - independent scheduler from ODDS_INGESTION_* above, runs on a cron (see
# TheOddsApiIngestionScheduler's @Scheduled crons, America/Bogota). Stays off (false) until we
# deliberately turn it on for production - see the budget comment on theoddsapi-ingestion in
# application.yml.
# THEODDSAPI_INGESTION_SCHEDULING_ENABLED=true

# Curated bookmaker list for The Odds API - see the comment on theoddsapi-ingestion.bookmakers
# in application.yml for how this was derived (clone/exchange exclusions, confirmed against
# real data 2026-08-26).
# THEODDSAPI_INGESTION_BOOKMAKERS=betclic_fr,betonlineag,betsson,codere_it,coolbet,everygame,gtbets,leovegas_se,marathonbet,mybookieag,onexbet,pinnacle,pmu_fr,sport888,suprabets,tipico_de,unibet_fr,unibet_nl,unibet_se,williamhill,winamax_de,winamax_fr

# Hot-match refresh (final hour before kickoff) and match status auto-update. Both stay off
# (false) until we deliberately turn them on together - see the hot-refresh and
# match-status-update comments in application.yml.
# FINAL_HOUR_WINDOW_MINUTES=60
# HOT_REFRESH_CHECK_INTERVAL=1800000
# HOT_REFRESH_MONTHLY_BUDGET=50
# HOT_REFRESH_SCHEDULING_ENABLED=true
# MATCH_DURATION_HOURS=2
# MATCH_STATUS_UPDATE_SCHEDULING_ENABLED=true

# OddsPapi requires exactly one 'bookmaker' AND at most 5 tournamentIds per /odds-by-tournaments
# call. pinnacle is the sharp reference book the true-probability estimate is built from; betano
# and betplay replace bet365/unibet (2026-08-23) - see the comment in application.yml for the
# betano-variant / betplay-clone caveats. All 3 confirmed non-cloned and present in the real
# OddsPapi catalog.
# ODDS_INGESTION_BOOKMAKERS=pinnacle,betano,betplay

# Odds ingestion runs on a cron (see IngestionScheduler's @Scheduled crons, America/Bogota) - see
# application.yml's odds-ingestion comment for the full budget recompute.
# ODDS_INGESTION_SCHEDULING_ENABLED=true

# Reference data (participant names) sync interval, in milliseconds (default: 24 hours). Used to
# also sync the full bookmaker catalog (1 more call/sync) - dropped since odds-ingestion.bookmakers
# is now a small fixed, pre-verified list (see ReferenceDataSyncService). 1 call/sync x 1 sync/day
# x 30 days = 30 calls/month - counted in the odds-ingestion budget comment above, not independent of it.
REFERENCE_DATA_SYNC_INTERVAL=86400000
# REFERENCE_DATA_SYNC_SCHEDULING_ENABLED=true

# How long a value bet / surebet stays "active" after being detected, in hours (default: 48 -
# double the 24h ingestion interval, so a single missed cycle doesn't blank out the active list)
# OPPORTUNITY_STALENESS_HOURS=48
