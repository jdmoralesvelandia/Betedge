# Copiar a .env, en este mismo directorio (betedge/), junto a docker-compose.prod.yml, y
# rellenar con valores REALES de producción - nunca reusar ningún valor de betedge/.env (dev).
# Nunca comitear el .env real (ver .gitignore).
#
# docker-compose.prod.yml carga este archivo automáticamente: Compose busca ./.env junto al
# propio archivo de compose por convención, así que no hace falta pasar --env-file si el
# archivo real se llama .env y vive aquí mismo.
#
# Las variables de abajo son exactamente (ni una más, ni una menos) las que
# docker-compose.prod.yml referencia con ${...} - si esta lista alguna vez queda
# desactualizada, ese archivo es la fuente de verdad, no este.
#
# Nota: GOOGLE_OAUTH_CLIENT_ID NO aparece acá a propósito - docker-compose.prod.yml no se lo
# pasa al backend, y el Client ID real ya es el valor por defecto hardcodeado en
# application.yml (no es secreto, así que no hace falta overridearlo por entorno). Lo que sí
# hace falta para Google en producción son dos pasos aparte, no una variable acá: agregar el
# dominio nuevo en "Authorized JavaScript origins" en Google Cloud Console, y pasar
# VITE_GOOGLE_CLIENT_ID (mismo valor de siempre) al build del frontend - ver el checklist de
# despliegue en CLAUDE.md.

# --- Base de datos (Postgres) ---
# Nuevas credenciales para producción - nunca "betedge"/"betedge" (las de dev).
DB_NAME=betedge
DB_USERNAME=betedge
DB_PASSWORD=

# --- JWT (secret debe tener al menos 32 bytes para HS256) ---
# Generar con: openssl rand -base64 32 - nunca el valor de betedge/.env (dev).
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Bootstrap del primer admin real ---
# Header X-Bootstrap-Secret que espera POST /auth/bootstrap-admin. Generar con:
# openssl rand -base64 32 - nunca el valor de betedge/.env (dev). No hay ningún admin
# todavía en una base de datos de producción recién creada - este secreto es el único camino
# para crear el primero.
ADMIN_BOOTSTRAP_SECRET=

# --- CORS ---
# Normalmente un solo origen: el frontend se sirve same-origin vía Nginx (ver
# deploy/nginx.conf.template), así que esto y DOMAIN_NAME abajo suelen compartir el mismo
# dominio. Lista solo importa si un segundo origen (alias www., frontend de staging) también
# necesita llamar a esta API directamente. Ver SecurityConfig.corsConfigurationSource.
ALLOWED_ORIGINS=https://CAMBIAR-por-el-dominio-real

# --- Dominio (usado por el servicio nginx, ver deploy/nginx.conf.template y setup-tls.sh) ---
DOMAIN_NAME=CAMBIAR-por-el-dominio-real

# --- Proveedores de cuotas ---
# Pueden ser las mismas keys de dev si son la misma cuenta de proveedor - no son
# credenciales "de entorno", son cuota compartida del proveedor.
ODDSPAPI_API_KEY=
THEODDSAPI_API_KEY=

# --- Schedulers de ingesta ---
# Cada uno se enciende explícitamente, uno por uno, cuando se decida - no todos a la vez solo
# por ser "producción". Ver el presupuesto de cada uno en application.yml/CLAUDE.md antes de
# encender THEODDSAPI/hot-refresh.
ODDS_INGESTION_SCHEDULING_ENABLED=true
THEODDSAPI_INGESTION_SCHEDULING_ENABLED=false
HOT_REFRESH_SCHEDULING_ENABLED=false
MATCH_STATUS_UPDATE_SCHEDULING_ENABLED=false
REFERENCE_DATA_SYNC_SCHEDULING_ENABLED=true
